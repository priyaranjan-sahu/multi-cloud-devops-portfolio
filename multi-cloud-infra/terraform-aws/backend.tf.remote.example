# =============================================================================
# Example: Switch terraform-aws to a remote S3 backend
# =============================================================================
# 1. Provision the bucket + lock table:
#       cd ../terraform-bootstrap && terraform init && terraform apply
#
# 2. Replace the `backend "local"` block in main.tf with the block below and
#    fill in the values printed by the bootstrap module, then:
#       terraform init -migrate-state
# =============================================================================

# terraform {
#   backend "s3" {
#     bucket         = "REPLACE_WITH_BOOTSTRAP_STATE_BUCKET"
#     key            = "terraform-aws/terraform.tfstate"
#     region         = "us-east-1"
#     encrypt        = true
#     dynamodb_table = "REPLACE_WITH_BOOTSTRAP_LOCK_TABLE"
#   }
# }
